# Copia este archivo como .env y cambia las contraseñas. El .env nunca se sube al repositorio.

# Backend
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# Orígenes permitidos para la interfaz web (separados por coma). "*" acepta cualquiera.
CORS_ORIGIN=*

# Rutas
# Costo de operar un camión por kilómetro, en pesos (supuesto para comparar camión contra tren)
COSTO_KM_CAMION=25
# Rutas alternativas que se piden a Neo4j antes de filtrar por restricciones
RUTAS_CANDIDATAS=10

# PostgreSQL
PG_HOST=localhost
PG_PORT=5433
PG_DATABASE=hopwright
PG_USER=hopwright
PG_PASSWORD=cambia_esta_contrasena

# MongoDB
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=hopwright
MONGO_USER=hopwright
MONGO_PASSWORD=cambia_esta_contrasena

# Neo4j (la contraseña debe tener al menos 8 caracteres)
NEO4J_HOST=localhost
NEO4J_BOLT_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cambia_esta_contrasena
