{
  "name": "hopwright-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API de Hopwright: coordina PostgreSQL, MongoDB y Neo4j",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run unit",
    "test:integration": "vitest run integration",
    "test:consistencia": "vitest run -c vitest.consistencia.config.ts",
    "rendimiento": "tsx ../tests/rendimiento/rendimiento.mts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/jwt": "^10.2.9",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.4",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "mongodb": "^7.9.1",
    "neo4j-driver": "^6.3.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
