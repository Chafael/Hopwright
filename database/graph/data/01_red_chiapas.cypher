  {a: '07108', b: '07123', km: 95, min: 110, caseta: 0, via: 'Estatal'},
  {a: '07110', b: '07111', km: 32.2, min: 65, caseta: 0, via: 'Estatal'},
  {a: '07112', b: 'INT-OXC', km: 21.2, min: 38, caseta: 0, via: 'Estatal'},
  {a: '07113', b: '07119', km: 9.9, min: 29, caseta: 0, via: 'Terracería'},
  {a: '07114', b: '07115', km: 160.5, min: 166, caseta: 0, via: 'Federal'},
  {a: '07114', b: '07116', km: 33.1, min: 55, caseta: 0, via: 'Estatal'},
  {a: '07115', b: '07116', km: 100.2, min: 142, caseta: 0, via: 'Federal'},
  {a: '07117', b: '07120', km: 30.4, min: 59, caseta: 0, via: 'Estatal'},
  {a: '07117', b: '07125', km: 41.9, min: 72, caseta: 0, via: 'Estatal'},
  {a: '07120', b: '07125', km: 36.1, min: 65, caseta: 0, via: 'Estatal'},
  {a: '07122', b: '07123', km: 51.6, min: 67, caseta: 0, via: 'Estatal'},
  {a: 'INT-CRU', b: 'INT-TPN', km: 52.4, min: 70, caseta: 0, via: 'Federal'}
] AS t
MATCH (x) WHERE (x:Ciudad AND x.idCiudad = t.a) OR (x:Interseccion AND x.idInterseccion = t.a)
MATCH (y) WHERE (y:Ciudad AND y.idCiudad = t.b) OR (y:Interseccion AND y.idInterseccion = t.b)
MERGE (x)-[ida:CARRETERA {tipoVia: t.via}]->(y)
SET ida.distanciaKm = toFloat(t.km), ida.tiempoMin = t.min, ida.costoCaseta = toFloat(t.caseta), ida.pesoCosto = toFloat(t.caseta) + t.min * 0.000001, ida.abierto = true
MERGE (y)-[vuelta:CARRETERA {tipoVia: t.via}]->(x)
SET vuelta.distanciaKm = toFloat(t.km), vuelta.tiempoMin = t.min, vuelta.costoCaseta = toFloat(t.caseta), vuelta.pesoCosto = toFloat(t.caseta) + t.min * 0.000001, vuelta.abierto = true;

// ---------- Vía férrea de la costa (dos aristas por tramo) ----------
// costoTon: pesos por tonelada transportada en ese tramo
UNWIND [
  {a: 'EST-ARR', b: 'EST-TON', km: 25, min: 40,  costoTon: 15},
  {a: 'EST-TON', b: 'EST-PIJ', km: 75, min: 110, costoTon: 45},
  {a: 'EST-PIJ', b: 'EST-HUI', km: 90, min: 130, costoTon: 54},
  {a: 'EST-HUI', b: 'EST-TAP', km: 40, min: 60,  costoTon: 24}
] AS t
MATCH (x:Estacion {idEstacion: t.a}), (y:Estacion {idEstacion: t.b})
MERGE (x)-[ida:VIA_FERREA]->(y)
SET ida.distanciaKm = toFloat(t.km), ida.tiempoMin = t.min, ida.costoPorTonelada = toFloat(t.costoTon)
MERGE (y)-[vuelta:VIA_FERREA]->(x)
SET vuelta.distanciaKm = toFloat(t.km), vuelta.tiempoMin = t.min, vuelta.costoPorTonelada = toFloat(t.costoTon);
