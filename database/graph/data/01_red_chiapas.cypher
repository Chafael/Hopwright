// ---------- Intersecciones (ubicadas donde OSRM las ajusta a la carretera) ----------
UNWIND [
  {id: 'INT-CHC', nombre: 'Caseta Chiapa de Corzo', tipo: 'Caseta', lat: 16.73064, lon: -92.97940},
  {id: 'INT-OCO', nombre: 'Entronque Ocozocoautla', tipo: 'Cruce', lat: 16.76345, lon: -93.35314},
